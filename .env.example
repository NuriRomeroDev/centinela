# PostgreSQL (db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=centinela

# Backend
# Local dev: apunta a localhost. En docker-compose se reescribe al host "db:5432".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/centinela
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# CORS origins (JSON array; frontend origin)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# DB pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5.0

# DB retry — bounded exponential backoff + jitter at connection acquisition
DB_RETRY_INITIAL_BACKOFF=0.5
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_JITTER=0.25
